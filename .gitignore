# Every build directory: target/, and the target-* dirs parallel builds use.
/target*/
.semlith/
.DS_Store

# Publishing credentials — never commit
.env

# UltraShip: local-only workspace, never pushed
.ultraship/

# Python bytecode from the browser drive.
__pycache__/
*.pyc

# Agent worktrees, created per session and never part of the tree.
.claude/worktrees/

# The browser drive's local output: a transcript and a screenshot per check.
# Evidence for a run, never source, and never in the published crate.
drive-out/
